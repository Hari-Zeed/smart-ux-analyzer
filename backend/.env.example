# Smart UX Analyzer – Backend Environment Variables
# Copy this file to .env and fill in your API keys

# ── Google PageSpeed Insights API Key ─────────────────────────────────────────
# Required for real Lighthouse scores (performance, SEO, accessibility, Core Web Vitals)
# Get yours free at: https://console.cloud.google.com/apis/credentials
# Enable: "PageSpeed Insights API" in the Google Cloud Console
PAGESPEED_API_KEY=

# ── Anthropic Claude API Key ───────────────────────────────────────────────────
# Required for AI-powered UX suggestions (uses claude-3-haiku-20240307)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Change this to a strong random secret in production
SECRET_KEY=smart-ux-analyzer-jwt-secret-change-in-production-2024

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Server Port (default: 8000) ───────────────────────────────────────────────
PORT=8000
