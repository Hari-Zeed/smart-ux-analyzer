{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "backend/main.py"
    },
    {
      "source": "/analyze",
      "destination": "backend/main.py"
    },
    {
      "source": "/reports",
      "destination": "backend/main.py"
    },
    {
      "source": "/reports/:path*",
      "destination": "backend/main.py"
    },
    {
      "source": "/profile/:id",
      "destination": "backend/main.py"
    },
    {
      "source": "/stats/:id",
      "destination": "backend/main.py"
    },
    {
      "source": "/settings/update",
      "destination": "backend/main.py"
    },
    {
      "source": "/settings/:id",
      "destination": "backend/main.py"
    },
    {
      "source": "/auth/:path*",
      "destination": "backend/main.py"
    }
  ]
}
